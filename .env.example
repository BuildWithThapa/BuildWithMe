# ============================================
# Supabase (public — safe for browser, restricted by Row Level Security)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# Supabase (server-only — NEVER prefix with NEXT_PUBLIC_, never expose to client)
# ============================================
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Site
# ============================================
NEXT_PUBLIC_SITE_URL=https://buildwiththapa.np
NEXT_PUBLIC_SITE_NAME=BuildWithThapa

# ============================================
# SMTP — contact form & transactional notifications
# ============================================
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=hello@buildwiththapa.np
CONTACT_FORM_RECIPIENT=hello@buildwiththapa.np

# ============================================
# Security
# ============================================
# Random 32+ char secret used to sign rate-limit / CSRF tokens
APP_SECRET=generate-a-long-random-string-here
